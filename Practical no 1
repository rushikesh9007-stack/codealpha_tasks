
#include <iostream>
#include <cstdlib>
#include <cstring>
#include <algorithm>
using namespace std;

struct Student
{
    int id;
    char name[50];
    float cgpa;
};

int main()
{
    Student *s = NULL;
    int n = 0, choice, key;

    do
    {
        cout << "\n--- STUDENT DATABASE ---";
        cout << "\n1. Add Student";
        cout << "\n2. Display Students";
        cout << "\n3. Linear Search";
        cout << "\n4. Binary Search";
        cout << "\n5. Exit";
        cout << "\nEnter your choice: ";
        cin >> choice;

        switch(choice)
        {
            case 1:
                s = (Student*)realloc(s, (n + 1) * sizeof(Student));

                if(s == NULL)
                {
                    cout << "Memory allocation failed!";
                    return 1;
                }

                cout << "Enter Student ID: ";
                cin >> s[n].id;

                cout << "Enter Student Name: ";
                cin.ignore();
                cin.getline(s[n].name, 50);

                cout << "Enter CGPA: ";
                cin >> s[n].cgpa;

                n++;
                cout << "Student added successfully!";
                break;

            case 2:
                if(n == 0)
                {
                    cout << "No student records found!";
                    break;
                }

                cout << "\nID\tName\tCGPA\n";
                for(int i = 0; i < n; i++)
                {
                    cout << s[i].id << "\t"
                         << s[i].name << "\t"
                         << s[i].cgpa << endl;
                }
                break;

            case 3:
                cout << "Enter Student ID to search: ";
                cin >> key;

                {
                    int found = 0;

                    for(int i = 0; i < n; i++)
                    {
                        if(s[i].id == key)
                        {
                            cout << "Student Found!";
                            cout << "\nID: " << s[i].id;
                            cout << "\nName: " << s[i].name;
                            cout << "\nCGPA: " << s[i].cgpa;
                            found = 1;
                            break;
                        }
                    }

                    if(!found)
                        cout << "Student not found!";
                }
                break;

            case 4:
                cout << "Enter Student ID to search: ";
                cin >> key;

                sort(s, s + n, [](Student a, Student b)
                {
                    return a.id < b.id;
                });

                {
                    int low = 0, high = n - 1;
                    int mid, found = 0;

                    while(low <= high)
                    {
                        mid = (low + high) / 2;

                        if(s[mid].id == key)
                        {
                            cout << "Student Found!";
                            cout << "\nID: " << s[mid].id;
                            cout << "\nName: " << s[mid].name;
                            cout << "\nCGPA: " << s[mid].cgpa;
                            found = 1;
                            break;
                        }
                        else if(s[mid].id < key)
                        {
                            low = mid + 1;
                        }
                        else
                        {
                            high = mid - 1;
                        }
                    }

                    if(!found)
                        cout << "Student not found!";
                }
                break;

            case 5:
                cout << "Exiting program...";
                break;

            default:
                cout << "Invalid choice!";
        }

    } while(choice != 5);

    free(s);

    return 0;
}
